@article{linSexualReproductionPartners2005,
  title = {Sexual Reproduction between Partners of the Same Mating Type in {{Cryptococcus}} Neoformans},
  author = {Lin, Xiaorong and Hull, Christina M. and Heitman, Joseph},
  date = {2005-04},
  journaltitle = {Nature},
  volume = {434},
  number = {7036},
