@article{fisherChytridFungiGlobal2020,
  title = {Chytrid Fungi and Global Amphibian Declines},
  author = {Fisher, Matthew C. and Garner, Trenton W. J.},
  date = {2020-06-01},
  journaltitle = {Nature Reviews Microbiology},
  shortjournal = {Nat Rev Microbiol},
  volume = {18},
  number = {6},
  pages = {332--343},
  issn = {1740-1534},
  doi = {10.1038/s41579-020-0335-x},
  url = {https://doi.org/10.1038/s41579-020-0335-x},
  urldate = {2024-04-11},
  abstract = {Discovering that chytrid fungi cause chytridiomycosis in amphibians represented a paradigm shift in our understanding of how emerging infectious diseases contribute to global patterns of biodiversity loss. In this Review we describe how the use of multidisciplinary biological approaches has been essential to pinpointing the origins of amphibian-parasitizing chytrid fungi, including Batrachochytrium dendrobatidis and Batrachochytrium salamandrivorans, as well as to timing their emergence, tracking their cycles of expansion and identifying the core mechanisms that underpin their pathogenicity. We discuss the development of the experimental methods and bioinformatics toolkits that have provided a fuller understanding of batrachochytrid biology and informed policy and control measures.},
  langid = {english},
  keywords = {Conservation biology,Fungal ecology,Fungal evolution,Fungal genomics,Fungal pathogenesis,Herpetology,Invasive species},
  file = {/Users/canonmallory/Zotero/storage/5YSGDNUW/Fisher and Garner - 2020 - Chytrid fungi and global amphibian declines.pdf}
}

@article{fisherDevelopmentWorldwideUse2018,
  title = {Development and Worldwide Use of Non-Lethal, and Minimal Population-Level Impact, Protocols for the Isolation of Amphibian Chytrid Fungi},
  author = {Fisher, Matthew C. and Ghosh, Pria and Shelton, Jennifer M. G. and Bates, Kieran and Brookes, Lola and Wierzbicki, Claudia and Rosa, Gonçalo M. and Farrer, Rhys A. and Aanensen, David M. and Alvarado-Rybak, Mario and Bataille, Arnaud and Berger, Lee and Böll, Susanne and Bosch, Jaime and Clare, Frances C. and A. Courtois, Elodie and Crottini, Angelica and Cunningham, Andrew A. and Doherty-Bone, Thomas M. and Gebresenbet, Fikirte and Gower, David J. and Höglund, Jacob and James, Timothy Y. and Jenkinson, Thomas S. and Kosch, Tiffany A. and Lambertini, Carolina and Laurila, Anssi and Lin, Chun-Fu and Loyau, Adeline and Martel, An and Meurling, Sara and Miaud, Claude and Minting, Pete and Ndriantsoa, Serge and O’Hanlon, Simon J. and Pasmans, Frank and Rakotonanahary, Tsanta and Rabemananjara, Falitiana C. E. and Ribeiro, Luisa P. and Schmeller, Dirk S. and Schmidt, Benedikt R. and Skerratt, Lee and Smith, Freya and Soto-Azat, Claudio and Tessa, Giulia and Toledo, Luís Felipe and Valenzuela-Sánchez, Andrés and Verster, Ruhan and Vörös, Judit and Waldman, Bruce and Webb, Rebecca J. and Weldon, Che and Wombwell, Emma and Zamudio, Kelly R. and Longcore, Joyce E. and Garner, Trenton W. J.},
  date = {2018-05-17},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci Rep},
  volume = {8},
  number = {1},
  pages = {7772},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-018-24472-2},
  url = {https://www.nature.com/articles/s41598-018-24472-2},
  urldate = {2024-12-03},
  abstract = {Parasitic chytrid fungi have emerged as a significant threat to amphibian species worldwide, necessitating the development of techniques to isolate these pathogens into culture for research purposes. However, early methods of isolating chytrids from their hosts relied on killing amphibians. We modified a pre-existing protocol for isolating chytrids from infected animals to use toe clips and biopsies from toe webbing rather than euthanizing hosts, and distributed the protocol to researchers as part of the BiodivERsA project RACE; here called the RML protocol. In tandem, we developed a lethal procedure for isolating chytrids from tadpole mouthparts. Reviewing a database of use a decade after their inception, we find that these methods have been applied across 5 continents, 23 countries and in 62 amphibian species. Isolation of chytrids by the non-lethal RML protocol occured in 18\% of attempts with 207 fungal isolates and three species of chytrid being recovered. Isolation of chytrids from tadpoles occured in 43\% of attempts with 334 fungal isolates of one species (Batrachochytrium dendrobatidis) being recovered. Together, these methods have resulted in a significant reduction and refinement of our use of threatened amphibian species and have improved our ability to work with this group of emerging pathogens.},
  langid = {english},
  keywords = {Biological techniques,Ecological epidemiology,Microbiology},
  file = {/Users/canonmallory/Zotero/storage/W7BIZYW6/Fisher et al. - 2018 - Development and worldwide use of non-lethal, and m.pdf}
}

