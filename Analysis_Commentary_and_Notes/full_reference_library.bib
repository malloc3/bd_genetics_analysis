@article{clareAssessingAbilitySwab2016,
  title = {Assessing the Ability of Swab Data to Determine the True Burden of Infection for the Amphibian Pathogen {{Batrachochytrium}} Dendrobatidis},
  author = {Clare, Frances and Daniel, Olivia and Garner, Trent and Fisher, Matthew},
  date = {2016-06-01},
  journaltitle = {EcoHealth},
  shortjournal = {EcoHealth},
  volume = {13},
  number = {2},
  pages = {360--367},
  issn = {1612-9210},
  doi = {10.1007/s10393-016-1114-z},
  url = {https://doi.org/10.1007/s10393-016-1114-z},
  urldate = {2024-04-11},
  abstract = {Batrachochytrium dendrobatidis (Bd) is a pathogenic fungus which causes the disease chytridiomycosis in amphibians by infecting the anian and then processed to yield DNA for detection by qPCR. This method has been used to infer a threshold of lethal infection in some species; however, how reliable and reproducible the swabbing method is at detecting the true burden of infection suffered by individuals is not known. European midwife toads, Alytes obstetricans, are susceptible to chytridiomycosis and are highly parasitised by Bd across Europe. By quantifying Bd-load throughout the entire skin and comparing this to swab results taken from the same individual, we determined whether epidermal swabs provide a quantifiable and accurate indication of the true fungal burden suffered. Further, we examined whether we could infer a threshold for lethal infection based on comparison of swab data taken from infected A. obstetricans exhibiting different clinical states. From swab data, we detected significantly higher fungal burdens from moribund metamorphs compared to visually healthy individuals; however, the ability of these swab data to provide an accurate indication of the true fungal burden was not reliable. These data suggest that fungal load dynamics play an important role in disease-induced mortality in A. obstetricans at these sites, but that using swab data to infer an exact threshold for Bd-associated mortality might be inappropriate and misleading.},
  langid = {english},
  keywords = {Alytes obstetricans,Batrachochytrium dendrobatidis,chytridiomycosis,emerging infectious diseases,infection threshold,qPCR},
  file = {/Users/canonmallory/Zotero/storage/AVYR8KJ2/Clare et al. - 2016 - Assessing the ability of swab data to determine th.pdf}
}

@article{claytorSusceptibilityFrogsChytridiomycosis2019,
  title = {Susceptibility of Frogs to Chytridiomycosis Correlates with Increased Levels of Immunomodulatory Serotonin in the Skin},
  author = {Claytor, Sieara C. and Gummer, Joel P.A. and Grogan, Laura F. and Skerratt, Lee F. and Webb, Rebecca J. and Brannelly, Laura A. and Berger, Lee and Roberts, Alexandra A.},
  date = {2019},
  journaltitle = {Cellular Microbiology},
  volume = {21},
  number = {10},
  pages = {e13089},
  issn = {1462-5822},
  doi = {10.1111/cmi.13089},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/cmi.13089},
  urldate = {2024-04-11},
  abstract = {Chytridiomycosis, caused by the fungus Batrachochytrium dendrobatidis (Bd), is a skin disease responsible for the global decline of amphibians. Frog species and populations can vary in susceptibility, but this phenomenon remains poorly understood. Here, we investigated serotonin in the skin of infected and uninfected frogs. In more susceptible frog populations, skin serotonin rose with increasing infection intensity, but decreased in later stages of the disease. The more resistant population maintained a basal level of skin serotonin. Serotonin inhibited both Bd sporangial growth and Jurkat lymphocyte proliferation in vitro. However, serotonin accumulates in skin granular glands, and this compartmentalisation may prevent inhibition of Bd growth in vivo. We suggest that skin serotonin increases in susceptible frogs due to pathogen excretion of precursor tryptophan, but that resistant frogs are able to control the levels of serotonin. Overall, the immunosuppressive effects of serotonin may contribute to the susceptibility of frogs to chytridiomycosis.},
  langid = {english},
  file = {/Users/canonmallory/Zotero/storage/GU3WEG79/Claytor et al. - 2019 - Susceptibility of frogs to chytridiomycosis correl.pdf;/Users/canonmallory/Zotero/storage/NPT8WTMT/cmi.html}
}

