@article{murphyChytridiomycosisDwarfAfrican2015,
  title = {Chytridiomycosis in Dwarf {{African}} Frogs {{Hymenochirus}} Curtipes},
  author = {Murphy, Bg and Hillman, C and Groff, Jm},
  date = {2015-05-11},
  journaltitle = {Diseases of Aquatic Organisms},
  shortjournal = {Dis. Aquat. Org.},
  volume = {114},
  number = {1},
  pages = {69--75},
  issn = {0177-5103, 1616-1580},
  doi = {10.3354/dao02851},
  url = {http://www.int-res.com/abstracts/dao/v114/n1/p69-75/},
  urldate = {2024-05-28},
  abstract = {Chytridiomycosis, resulting from an infection with the fungal agent Batrachochytrium dendrobatidis (Bd), has resulted in widespread population declines in both wild and captive amphibians. The dwarf African frog (DAF) Hymenochirus curtipes is native to central Africa and is commonly sold throughout North America as an aquarium pet species. Here we document fatal chytridiomycosis resulting from cutaneous Bd infections in DAF purchased directly from a pet store and from a historical lethal epizootic occurring at an aquaculture facility in central California, USA, more than 25 yr ago. Histological lesions and PCR-amplified sequence data were consistent with the etiology of Bd. The potential epidemiological relevance of this infection in DAF is discussed.},
  langid = {english},
  keywords = {Batrachochytrium dendrobatidis,Bd,Bd Symptoms,Chytridiomycosis,Dwarf,Frog,Hymenochirus},
