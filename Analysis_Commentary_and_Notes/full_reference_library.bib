@article{apponyiHostdefencePeptidesAustralian2004,
  title = {Host-Defence Peptides of {{Australian}} Anurans: Structure, Mechanism of Action and Evolutionary Significance},
  shorttitle = {Host-Defence Peptides of {{Australian}} Anurans},
  author = {Apponyi, Margit A. and Pukala, Tara L. and Brinkworth, Craig S. and Maselli, Vita M. and Bowie, John H. and Tyler, Michael J. and Booker, Grant W. and Wallace, John C. and Carver, John A. and Separovic, Frances and Doyle, Jason and Llewellyn, Lyndon E.},
  date = {2004-06},
  journaltitle = {Peptides},
  shortjournal = {Peptides},
  volume = {25},
  number = {6},
  eprint = {15203252},
  eprinttype = {pubmed},
  pages = {1035--1054},
  issn = {0196-9781},
  doi = {10.1016/j.peptides.2004.03.006},
  abstract = {Host-defence peptides secreted from the skin glands of Australian frogs and toads, are, with a few notable exceptions, different from those produced by anurans elsewhere. This review summarizes the current knowledge of the following classes of peptide isolated and characterized from Australian anurans: neuropeptides (including smooth muscle active peptides, and peptides that inhibit the production of nitric oxide from neuronal nitric oxide synthase), antimicrobial and anticancer active peptides, antifungal peptides and antimalarial peptides. Other topics covered include sex pheromones of anurans, and the application of peptide profiling to (i). recognize particular populations of anurans of the same species and to differentiate between species, and (ii). investigate evolutionary aspects of peptide formation.},
  langid = {english},
  keywords = {Animals,Anura,Australia,Biological Evolution,Peptides}
}

@article{attiyehGenomicCopyNumber2009,
  title = {Genomic Copy Number Determination in Cancer Cells from Single Nucleotide Polymorphism Microarrays Based on Quantitative Genotyping Corrected for Aneuploidy},
  author = {Attiyeh, Edward F. and Diskin, Sharon J. and Attiyeh, Marc A. and Mossé, Yaël P. and Hou, Cuiping and Jackson, Eric M. and Kim, Cecilia and Glessner, Joseph and Hakonarson, Hakon and Biegel, Jaclyn A. and Maris, John M.},
  date = {2009-01-02},
  journaltitle = {Genome Research},
  shortjournal = {Genome Res.},
  volume = {19},
  number = {2},
  eprint = {19141597},
  eprinttype = {pubmed},
  pages = {276--283},
  publisher = {Cold Spring Harbor Lab},
  issn = {1088-9051, 1549-5469},
  doi = {10.1101/gr.075671.107},
  url = {https://genome.cshlp.org/content/19/2/276},
  urldate = {2024-07-10},
  abstract = {Microarrays are frequently used to profile genome-wide copy number (CN) aberrations. While generally robust for detecting CN variants in germline DNA, the methods used to derive CN from signal intensity values have been suboptimal when applied to cancer genomes. The complexity of genomic aberrations in cancer makes it more difficult to discriminate between signal and noise, and measuring CN as a discrete variable does not account for tumor heterogeneity. Furthermore, standard normalization approaches detect CN changes relative to the overall DNA content, which is often not diploid in cancer. We propose an algorithm that uses the degree of allelic imbalance as well as probe intensity, with a correction for aneuploidy, for a quantitative CN assessment and scoring of allelic ratios. This algorithm results in a more precise definition of CN and allelic aberration in the cancer genome, which is essential for translational efforts focused on using these tools for molecular diagnostics and for the discovery of therapeutic targets.},
  langid = {english},
  file = {/Users/canonmallory/Zotero/storage/59HHL3GV/Attiyeh et al. - 2009 - Genomic copy number determination in cancer cells .pdf}
}

@article{avelar-freitasTrypanBlueExclusion2014,
  title = {Trypan Blue Exclusion Assay by Flow Cytometry},
  author = {Avelar-Freitas, B.A. and Almeida, V.G. and Pinto, M.C.X. and Mourão, F.A.G. and Massensini, A.R. and Martins-Filho, O.A. and Rocha-Vieira, E. and Brito-Melo, G.E.A.},
