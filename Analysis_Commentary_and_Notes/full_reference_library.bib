@article{tytarModelingDistributionChytrid2023,
  title = {Modeling the {{Distribution}} of the {{Chytrid Fungus Batrachochytrium}} Dendrobatidis with {{Special Reference}} to {{Ukraine}}},
  author = {Tytar, Volodymyr and Nekrasova, Oksana and Pupins, Mihails and Skute, Arturs and Kirjušina, Muza and Gravele, Evita and Mezaraupe, Ligita and Marushchak, Oleksii and Čeirāns, Andris and Kozynenko, Iryna and Kulikova, Alena A.},
  date = {2023-06},
  journaltitle = {Journal of Fungi},
  volume = {9},
