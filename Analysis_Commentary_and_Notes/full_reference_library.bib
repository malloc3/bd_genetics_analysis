@article{botteryClimateChangeShifting2026,
  title = {Climate Change: Shifting Boundaries of Fungal Disease in {{Europe}} and Beyond},
  shorttitle = {Climate Change},
  author = {Bottery, Michael and Sedik, Sarah and Schwartz, Ilan and Hoenigl, Martin and Van Rhijn, Norman},
  date = {2026-01},
