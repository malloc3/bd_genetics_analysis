@article{kellyHighPhenotypicDiversity2024,
  title = {High Phenotypic Diversity Correlated with Genomic Variation across the {{European Batrachochytrium}} Salamandrivorans Epizootic},
  author = {Kelly, Moira and Cuomo, Christina A. and Beukema, Wouter and Carranza, Salvador and Erens, Jesse and Foubert, Marleen and Li, Zhimin and Lötters, Stefan and Schulz, Vanessa and Steinfartz, Sebastian and Praet, Sarah Van and Veith, Michael and Pasmans, Frank and Martel, An},
  date = {2024-10-16},
  journaltitle = {PLOS Pathogens},
  shortjournal = {PLOS Pathogens},
  volume = {20},
  number = {10},
  pages = {e1012579},
  publisher = {Public Library of Science},
  issn = {1553-7374},
  doi = {10.1371/journal.ppat.1012579},
  url = {https://journals.plos.org/plospathogens/article?id=10.1371/journal.ppat.1012579},
  urldate = {2025-10-23},
  abstract = {Recognizing the influence of pathogen diversity on infection dynamics is crucial for mitigating emerging infectious diseases. Characterising such diversity is often complex, for instance when multiple pathogen variants exist that interact differently with the environment and host. Here, we explore genotypic and phenotypic variation of Batrachochytrium salamandrivorans (Bsal), an emerging fungal pathogen that is driving declines among an increasing number of European amphibian species. For thirteen isolates, spanning most of the known temporal and geographical Bsal range in Europe, we mapped phenotypic diversity through numerous measurements that describe varying reproductive rates in vitro across a range of temperatures. Bsal isolates are revealed to have different thermal optima and tolerances, with phenotypic variation correlating with genomic diversity. Using a mechanistic niche model of the fire salamander (Salamandra salamandra) as an example, we illustrate how host steady-state body temperature and Bsal thermal range variation may influence pathogen growth through space and time across Europe. Our combined findings show how the identity of emergent pathogen variants may strongly influence when and which host populations are most at risk.},
  langid = {english},
  keywords = {Amphibian genomics,Amphibians,Body temperature,Europe,Fecundity,Fungal pathogens,Principal component analysis,Salamanders},
  file = {/Users/canonmallory/Zotero/storage/AICVCSQM/Kelly et al. - 2024 - High phenotypic diversity correlated with genomic variation across the European Batrachochytrium sal.pdf}
}

