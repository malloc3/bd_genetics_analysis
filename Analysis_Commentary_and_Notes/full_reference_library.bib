@article{kinkeadComparisonAnesthesiaMarking2006,
  title = {Comparison of {{Anesthesia}} and {{Marking Techniques}} on {{Stress}} and {{Behavioral Responses}} in {{Two Desmognathus Salamanders}}},
  author = {Kinkead, Karen E. and Lanham, J. Drew and Montanucci, Richard R.},
  date = {2006-09},
  journaltitle = {Journal of Herpetology},
  shortjournal = {hpet},
  volume = {40},
