@article{bradfordTemperatureModulationHighElevation1984,
  title = {Temperature {{Modulation}} in a {{High-Elevation Amphibian}}, {{Rana}} Muscosa},
  author = {Bradford, David F.},
  date = {1984},
  journaltitle = {Copeia},
  volume = {1984},
  number = {4},
  eprint = {1445341},
  eprinttype = {jstor},
  pages = {966--976},
  publisher = {{[American Society of Ichthyologists and Herpetologists (ASIH), Allen Press]}},
  issn = {0045-8511},
  doi = {10.2307/1445341},
  url = {https://www.jstor.org/stable/1445341},
  urldate = {2024-07-20},
  abstract = {Behavior to modulate body temperature was examined in frogs and tadpoles of Rana muscosa (Anura: Ranidae) during summer at elevations above 3060 m in the Sierra Nevada of California. Frogs tended to maximize body temperature at nearly all times during the day, as evidenced by comparisons between frog locations, body temperatures ( T b) and the equilibrium temperatures of model frogs. Frogs modulated T b by 1) basking in the sun; 2) moving between water and land, depending on which was warmer; and 3) selecting macrohabitat, concentrating in the warmer regions along shorelines. As a consequence of behavioral T b modulation, the daytime T b of telemetered frogs ranged up to 13.0, 17.5 and 18.6 C above ambient air temperature, wet bulb temperature and water temperature near shore, respectively. Despite behavioral modulation of T b, frogs in the field rarely achieved the mean selected temperature (MST), determined in a laboratory thermal gradient. Telemetered T b in the field averaged 17.2 C during the daytime, whereas daytime MST averaged 24.3 C. At night T b averaged 11.3 C in the field and 21.7 C in the thermal gradient. The maximum T b' s recorded were 28.4 C in the field and 28.6 C in the laboratory thermal gradient. During mid day, almost half the adult R. muscosa in one population formed aggregations of as many as 58 individuals. This behavior should minimize both evaporative water loss and heat loss from the sides of each animal. Tadpoles modulated T b by habitat selection. Before the spring overturn they remained in the warmer water below the thermocline. Thereafter, they moved each day to warm shallows near shore, where they sometimes aggregated by the hundreds. The maximum average T b of a population of tadpoles was 25.0 C, and the maximum individual T b was 27.0 C.},
  file = {/Users/canonmallory/Zotero/storage/T6CK6E7U/Bradford - 1984 - Temperature Modulation in a High-Elevation Amphibi.pdf}
}

