  title = {Neurohypophysial Function in Bullfrog ({{{\mkbibemph{Rana}}}}{\mkbibemph{ Catesbeiana}}) Tadpoles},
  author = {Bentley, P. J. and Greenwald, L.},
  date = {1970-04-01},
  journaltitle = {General and Comparative Endocrinology},
  shortjournal = {General and Comparative Endocrinology},
  volume = {14},
  number = {2},
  pages = {412--415},
